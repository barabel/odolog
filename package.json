{
  "name": "odolog",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:front": "npm -w @odolog/frontend run dev",
    "build": "npm -w @odolog/frontend run build",
    "lint": "npm -w @odolog/frontend run lint",
    "test": "npm -w @odolog/frontend run test",
    "test:watch": "npm -w @odolog/frontend run test:watch",
    "check": "npm run lint && npm run build && npm run test",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
